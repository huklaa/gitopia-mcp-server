# Gitopia MCP Server Configuration
# Copy this file to .env and fill in your values.

# Optional: Your Gitopia wallet mnemonic (BIP-39).
# If not set, a new wallet is auto-generated on first use and saved to
# ~/.mcp/gitopia/config/wallet.key. Set this only to reuse an existing wallet.
# WARNING: Keep this secret! Never commit your actual mnemonic.
# GITOPIA_MNEMONIC="your twelve or twenty-four word mnemonic phrase here"

# Optional: Comma-separated Gitopia gRPC endpoints.
# Defaults to gitopia-grpc.polkachu.com:11390
GITOPIA_GRPC_ENDPOINTS="gitopia-grpc.polkachu.com:11390"

# Optional: Wallet backend selection.
# "mnemonic" — derive from GITOPIA_MNEMONIC env var
# "keyring"  — use OS keyring
# "file"     — use wallet file
# "auto"     — try keyring, then mnemonic, then file (default)
GITOPIA_WALLET_BACKEND="auto"

# Optional: Workspace root directory for cloned repositories.
# Defaults to ~/.mcp/gitopia/workspace
MCP_WORKSPACE_PATH=""

# Optional: Default git user name for commits.
GIT_USER_NAME=""

# Optional: Default git user email for commits.
GIT_USER_EMAIL=""

# Optional: Log level (debug, info, warn, error).
# Defaults to info.
MCP_LOG_LEVEL="info"

# Optional: Trust level controls which tools are accessible.
# "readonly"   — only read/query tools (gitopia_list_*, gitopia_get_*, search_*, read_file)
# "localwrite" — readonly + local git/file operations (write_file, git_add, git_commit, etc.)
# "chainwrite" — full access including on-chain transactions (default)
TRUST_LEVEL="chainwrite"

# Optional: Transport protocol.
# "stdio" — standard I/O (default, for CLI usage)
# "http"  — HTTP server (for web integrations)
TRANSPORT="stdio"

# Optional: HTTP listen port (only used when TRANSPORT=http).
PORT="8080"

# Optional: Dry-run mode. Preview transactions without broadcasting.
# Set to "true" or "1" to enable.
DRY_RUN="false"

# Optional: Approval mode. Require explicit confirmation before broadcasting
# chain-write transactions. Pending transactions expire after APPROVAL_TTL.
APPROVAL_MODE="false"
APPROVAL_TTL="5m"

# Optional: Rate limiting for on-chain transactions.
# Prevents runaway agents from burning gas. Set to 0 to disable.
CHAIN_TX_PER_MINUTE=10
CHAIN_TX_PER_HOUR=100
